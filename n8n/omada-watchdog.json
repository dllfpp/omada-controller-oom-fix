{
  "name": "Omada watchdog",
  "nodes": [
    {"id":"a1","name":"Every hour","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[0,0],
     "parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":1,"triggerAtMinute":17}]}}},
    {"id":"a2","name":"Check controller","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[220,0],
     "parameters":{"url":"https://OMADA_CONTROLLER_IP:8043/api/info","options":{"allowUnauthorizedCerts":true,"timeout":30000,
       "response":{"response":{"neverError":true,"fullResponse":true}}}},
     "retryOnFail":true,"maxTries":3,"waitBetweenTries":5000,"onError":"continueRegularOutput"},
    {"id":"a3","name":"Working?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[440,0],
     "parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"combinator":"and",
       "conditions":[{"id":"c1","leftValue":"={{ !!($json.body && $json.body.result && $json.body.result.omadacId) }}","rightValue":true,
         "operator":{"type":"boolean","operation":"true","singleValue":true}}]},"options":{}}},
    {"id":"a4","name":"Restart Omada","type":"n8n-nodes-base.ssh","typeVersion":1,"position":[660,100],
     "parameters":{"authentication":"privateKey",
       "command":"={{ 'n8n ' + ($json.error ? ('error ' + ($json.error.message || $json.error.code || 'network')) : ('HTTP ' + ($json.statusCode || '?'))) }}"},
     "credentials":{"sshPrivateKey":{"id":"REPLACE_WITH_CREDENTIAL_ID","name":"Proxmox host - Omada watchdog key"}}}
  ],
  "connections": {
    "Every hour":{"main":[[{"node":"Check controller","type":"main","index":0}]]},
    "Check controller":{"main":[[{"node":"Working?","type":"main","index":0}]]},
    "Working?":{"main":[[],[{"node":"Restart Omada","type":"main","index":0}]]}
  },
  "settings":{"executionOrder":"v1"}
}
